#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
APP_URL="${BLOG_GUI_URL:-http://127.0.0.1:8501}"
HEALTH_URL="${APP_URL}/_stcore/health"
LOG_DIR="${REPO_ROOT}/.streamlit"
LOG_PATH="${LOG_DIR}/blog-gui.log"

open_workspace() {
  /usr/bin/open "${APP_URL}"
}

if /usr/bin/curl --fail --silent --show-error --max-time 1 "${HEALTH_URL}" >/dev/null 2>&1; then
  open_workspace
  exit 0
fi

mkdir -p "${LOG_DIR}"
nohup "${REPO_ROOT}/scripts/blog-gui" \
  --server.address 127.0.0.1 \
  --server.port 8501 \
  --server.headless true \
  >"${LOG_PATH}" 2>&1 &

for _attempt in {1..40}; do
  if /usr/bin/curl --fail --silent --show-error --max-time 1 "${HEALTH_URL}" >/dev/null 2>&1; then
    open_workspace
    exit 0
  fi
  sleep 0.5
done

echo "Blog GUI did not become ready. Check ${LOG_PATH}" >&2
exit 1
